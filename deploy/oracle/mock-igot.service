[Unit]
Description=Mock iGOT Karmayogi server (internal, port 8001)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/sih26101/mock-igot-server
ExecStart=/home/ubuntu/sih26101/venv/bin/uvicorn mock_igot_server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
