# ── MoSPI LMS Backend — Environment Configuration ────────────────────────────
# Copy this file to .env and fill in your actual values.
# The .env file is gitignored and should NEVER be committed.

# ── Shared database (Neon Postgres) ──────────────────────────────────────────
# All teammates/deployments point at the SAME database so logins are identical.
# Get the value from the team lead (never commit it). Leave unset to fall back
# to a local SQLite auth.db (per-machine credentials).
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Admin password used only when seeding a fresh DB (python -m auth.seed).
SEED_ADMIN_PASSWORD=admin123
# JWT signing key — use the same long random value across deployments.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# ── Deployment (frontend on another site, e.g. Vercel) ───────────────────────
# Extra allowed CORS origins, comma-separated (localhost:5173/3000 are built in).
# CORS_ORIGINS=https://your-app.vercel.app
# Refresh-token cookie. Cross-site frontend → none (forces Secure; needs HTTPS).
# COOKIE_SAMESITE=none

# ── iGOT Mock Server ──────────────────────────────────────────────────────────
IGOT_MOCK_BASE_URL=http://localhost:8001
IGOT_MOCK_TOKEN=mock-api-key-2026

# ── Live iGOT Karmayogi catalogue ─────────────────────────────────────────────
# Where the COURSE CATALOGUE comes from. Everything else (users, enrolments,
# ACBP, evidence, the FRAC dictionary) always comes from the mock server.
#   mock  the synthetic catalogue on :8001 — fully offline, and the only source
#         that carries enrollment_count / completion_rate.
#   live  the real iGOT catalogue (~5.2k courses) over its PUBLIC content APIs.
#         No credentials needed: iGOT serves content openly and gates only
#         per-user data. Falls back to the last harvest on disk, then the mock.
# IGOT_CATALOGUE_SOURCE=live
IGOT_LIVE_BASE_URL=https://portal.igotkarmayogi.gov.in
# Harvest the catalogue to disk first (also refreshes the KCM→FRAC crosswalk):
#   python -m scripts.fetch_live_catalog
# Optional. Only needed if Karmayogi Bharat ever issues this project a Kong
# consumer key — that key also unlocks the gated user/enrolment endpoints.
# IGOT_LIVE_TOKEN=
# Courses per search page, and the read timeout. Lower the page size on a slow
# link; the pager halves it automatically on a timeout anyway.
# IGOT_LIVE_PAGE_SIZE=400
# IGOT_LIVE_TIMEOUT=120
# Minimum cosine for a KCM theme → FRAC competency mapping. Default 0.55, which
# is the calibrated floor; lowering it admits visibly wrong mappings.
# KCM_CROSSWALK_MIN_SIM=0.55

# ── Assessment Studio LLMs (services/media_quiz/llm.py + providers.py) ────────
# Text prompts (document quiz, media quiz, fact-check/translation, Learning Mode)
# go to Groq first, then Gemini. Vision (video keyframes) uses Gemini only.
#
# Groq (https://console.groq.com/keys). Several keys may be comma-separated;
# they rotate when one is rate-limited (limits are per key AND per model).
GROQ_API_KEYS=
# Preference order; when every key is cooling for one model the next is tried.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# Gemini — fallback for text, required for vision.
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Must match DEFAULT_GEMINI_MODEL in services/media_quiz/llm.py (fallbacks follow it).
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Media quiz: YouTube links (services/media_quiz/media_io.py) ───────────────
# YouTube answers "Sign in to confirm you're not a bot" to most datacenter IPs, and
# gates the media URLs behind a PO token even when it does answer. Neither stops a
# quiz: captions are fetched separately and are enough on their own, so a deployed
# server builds captions-only quizzes (no OCR frames) without any of the settings
# below. They only matter for videos that have NO captions, where the audio track
# has to be downloaded and transcribed.
# Extraction retries these InnerTube player clients in order and keeps whichever
# gives the most (captions rank above streams):
# MEDIA_YOUTUBE_PLAYER_CLIENTS=default,android_vr,ios,tv_simply,web_embedded,mweb
# A PO-token provider restores the gated formats — video frames, and audio for
# caption-less videos — without an account:
#   docker run -d --restart unless-stopped -p 4416:4416 brainicism/bgutil-ytdlp-pot-provider
#   venv/bin/pip install bgutil-ytdlp-pot-provider
# MEDIA_YOUTUBE_POT_URL=http://127.0.0.1:4416
# If YouTube refuses the metadata too — which is what the Oracle VM gets: every player
# client AND a plain watch-page GET come back LOGIN_REQUIRED — only credentials or a
# different egress IP help. Export cookies.txt (Netscape format) from a browser signed
# into a THROWAWAY Google account (YouTube suspends accounts whose cookies are used from
# a server) and give it to the backend as one base64 line, which is the only shape .env
# can hold. deploy/oracle/youtube-access.sh --cookies <file> does the encoding for you.
# MEDIA_YOUTUBE_COOKIES_B64=IyBOZXRzY2FwZSBIVFRQIENvb2tpZSBGaWxlCg…
# Or as a path, if you can keep a file on the server (update.sh does not delete it):
# MEDIA_YOUTUBE_COOKIES_FILE=/home/ubuntu/yt-cookies.txt
# Or read them live from a local browser profile ("chrome", "firefox:default").
# Dev machines only — a server has no browser profile.
# MEDIA_YOUTUBE_COOKIES_FROM_BROWSER=chrome
# Or route yt-dlp through a residential proxy (the datacenter IP is the problem).
# MEDIA_YOUTUBE_PROXY=http://user:pass@host:port
#
# ── The relay tier (services/media_quiz/ytrelay.py) ──────────────────────────
# Asking YouTube from here is what fails, so this asks somebody else to: public
# Invidious / Piped / cobalt instances fetch from their own IPs and hand back the
# caption track (and, where they proxy media, a 360p stream). No account, no key.
# It is ON by default and needs no setting; instances are discovered live and raced
# in parallel behind a deadline, so when they all fail it costs seconds, not a request.
# Reality check (measured 2026-09-23): public instances are themselves half-walled by
# YouTube and half-dead, so a given video succeeds maybe a third of the time. Point it
# at an instance YOU run — anywhere that is not a flagged datacenter — and it becomes
# dependable. "auto" discovers, "off" disables, or list <kind>:<url> entries:
# MEDIA_YOUTUBE_RELAYS=piped:https://my-piped.example,invidious:https://my-inv.example
# Download video frames through the relay too (restores OCR evidence). Off by default
# because no *public* instance currently serves media bytes; turn it on with your own.
# MEDIA_YOUTUBE_RELAY_FRAMES=1
# MEDIA_YOUTUBE_RELAY_DEADLINE_S=15   # hard cap on the whole instance race
# MEDIA_YOUTUBE_RELAY_PENALTY_S=900   # how long a failing instance is skipped
#
# ── The Gemini tier (services/media_quiz/ytgemini.py) ────────────────────────
# Gemini accepts a PUBLIC YouTube URL and fetches the video on Google's side, so a
# walled datacenter IP (the Oracle VM) only talks to generativelanguage.googleapis.com.
# It returns a verbatim transcript + on-screen text, transcribed in parallel windows.
# On whenever GEMINI_API_KEY is set. auto = only when YouTube refuses this host;
# first = skip the direct probe (set this on the VM: that probe can only fail there).
# MEDIA_YOUTUBE_GEMINI=auto            # auto | first | off
# MEDIA_YOUTUBE_GEMINI_MODEL=          # default: GEMINI_MODEL, then the llm.py fallbacks
# MEDIA_YOUTUBE_GEMINI_WINDOW_S=300    # seconds of video per parallel request
# MEDIA_YOUTUBE_GEMINI_PARALLEL=6
# MEDIA_YOUTUBE_GEMINI_MAX_S=3600      # longer videos: windows spread evenly across them
# MEDIA_YOUTUBE_GEMINI_SCREEN=1        # also ask when captions came but frames did not
# MEDIA_YOUTUBE_GEMINI_RESOLUTION=MEDIA_RESOLUTION_LOW   # empty = model default
#
# ── Fetch scheduling and caching ─────────────────────────────────────────────
# The player clients are probed in parallel after the first one, so a fully walled
# host pays the slowest client instead of the sum of all of them.
# MEDIA_YOUTUBE_PROBE_WORKERS=5       # 1 = the old sequential chain
# MEDIA_YOUTUBE_PROBE_RETRIES=1       # per client; there is a whole chain behind each
# The same link is asked for repeatedly (retakes, demos). The fetched captions/streams
# are cached on disk per video id, and the finished quiz per (video, difficulty, lang),
# so a repeat is instant instead of minutes. 0 disables either.
# MEDIA_YOUTUBE_CACHE_TTL_S=86400     # the downloaded captions / media
# MEDIA_YOUTUBE_RESULT_TTL_S=86400    # the generated quiz

# ── Certificate evidence extraction (routers/competency.py) ───────────────────
# Gemini is used when GEMINI_API_KEY is set; otherwise pypdf/RapidOCR + e5 match.
# CERT_MATCH_FLOOR=0.80   # e5 cosine a FRAC competency must reach (local path)
# CERT_MAX_MB=10          # upload size limit

# ── Embedding models (optional overrides; defaults in ai/embedder.py) ─────────
# Gyan chat intent classification (multilingual). Re-check accuracy with
# `python scripts/eval_intents.py --model <name>` before changing.
# CHAT_EMBEDDER_MODEL=intfloat/multilingual-e5-small
# Course recommendation search (English catalogue).
# CATALOG_EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Recommendation engine (optional) ─────────────────────────────────────────
# Multilingual cross-encoder re-rank of the top 20 candidates (ai/reranker.py).
# Off by default: needs an ONNX export in ai/.cache/onnx/<model>/ or PyTorch
# (sentence-transformers) and a ~470 MB model download.
# ENABLE_CROSS_ENCODER=1
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# How often the catalogue is re-fetched from iGOT; the engine is rebuilt only if
# it changed (unchanged courses reuse vectors stored in the courses table). 0 = off.
# CATALOGUE_REFRESH_SECONDS=3600

# ── Ollama Local LLM (optional, not used by Gyan chat) ───────────────────────
# Install Ollama first, then pull models:
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.2

# ── ChromaDB Vector Store ─────────────────────────────────────────────────────
CHROMA_DB_DIR=./chroma_db
CHUNK_SIZE=800
CHUNK_OVERLAP=150
